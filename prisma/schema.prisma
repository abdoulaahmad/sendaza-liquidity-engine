generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RegistryStatus {
  ENABLED
  DISABLED
}

enum AssetKind {
  NATIVE
  TOKEN
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum OutboxStatus {
  PENDING
  LEASED
  DELIVERED
  QUARANTINED
}

enum PricingProviderType {
  COINBASE_PUBLIC
  MANUAL
  DETERMINISTIC_FAKE
}

enum PricingInstrumentKind {
  ASSET
  FIAT
}

enum RouteLegOperation {
  MULTIPLY
  DIVIDE
}

enum ReferenceRateStatus {
  ACCEPTED
  REJECTED
}

enum RateRoundingMode {
  HALF_EVEN
}

enum PricingRefreshJobStatus {
  PENDING
  LEASED
}

enum QuoteSide {
  BUY
}

enum QuotePolicyStatus {
  ACTIVE
  RETIRED
}

enum FeeRoundingMode {
  CEILING
}

enum DestinationRoundingMode {
  FLOOR
}

enum CustodyProviderType {
  FIREBLOCKS
  DETERMINISTIC_FAKE
}

enum TreasuryWalletRole {
  PRIMARY
  GAS
}

enum TreasuryVerificationStatus {
  MATCHED
  UNVERIFIED
  MISMATCH
  STALE
}

enum TreasurySyncJobStatus {
  PENDING
  LEASED
}

enum FundingIntentStatus {
  CREATED
  OBSERVED
  CONFIRMED
  CANCELLED
}

model Asset {
  id                String             @id @default(uuid()) @db.Uuid
  symbol            String             @unique @db.VarChar(20)
  name              String             @db.VarChar(100)
  kind              AssetKind
  decimals          Int
  status            RegistryStatus     @default(ENABLED)
  nativeNetworks    Network[]          @relation("NativeAsset")
  assetNetworks     AssetNetwork[]
  markets           Market[]
  pricingInstrument PricingInstrument?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("assets")
}

model FiatCurrency {
  id                String             @id @default(uuid()) @db.Uuid
  code              String             @unique @db.VarChar(3)
  name              String             @db.VarChar(100)
  decimals          Int
  status            RegistryStatus     @default(ENABLED)
  markets           Market[]
  pricingInstrument PricingInstrument?
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("fiat_currencies")
}

model Network {
  id                    String         @id @default(uuid()) @db.Uuid
  code                  String         @unique @db.VarChar(30)
  name                  String         @db.VarChar(100)
  nativeAssetId         String         @map("native_asset_id") @db.Uuid
  nativeAsset           Asset          @relation("NativeAsset", fields: [nativeAssetId], references: [id])
  addressFamily         String         @map("address_family") @db.VarChar(30)
  requiredConfirmations Int            @map("required_confirmations")
  status                RegistryStatus @default(ENABLED)
  assetNetworks         AssetNetwork[]
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("networks")
}

model AssetNetwork {
  id                  String                  @id @default(uuid()) @db.Uuid
  assetId             String                  @map("asset_id") @db.Uuid
  asset               Asset                   @relation(fields: [assetId], references: [id])
  networkId           String                  @map("network_id") @db.Uuid
  network             Network                 @relation(fields: [networkId], references: [id])
  tokenStandard       String                  @map("token_standard") @db.VarChar(30)
  contractAddress     String?                 @map("contract_address") @db.VarChar(255)
  networkDecimals     Int                     @map("network_decimals")
  providerAssetCode   String?                 @map("provider_asset_code") @db.VarChar(100)
  depositsEnabled     Boolean                 @default(false) @map("deposits_enabled")
  withdrawalsEnabled  Boolean                 @default(false) @map("withdrawals_enabled")
  minWithdrawalAtomic BigInt?                 @map("min_withdrawal_atomic")
  maxWithdrawalAtomic BigInt?                 @map("max_withdrawal_atomic")
  status              RegistryStatus          @default(ENABLED)
  defaultForMarkets   Market[]
  quotes              Quote[]
  treasuryWallets     TreasuryWallet[]
  treasurySnapshots   TreasurySnapshot[]
  inventoryState      TreasuryInventoryState?
  fundingIntents      TreasuryFundingIntent[]
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assetId, networkId])
  @@map("asset_networks")
}

model CustodyProviderConfiguration {
  id        String              @id @default(uuid()) @db.Uuid
  code      String              @unique @db.VarChar(50)
  type      CustodyProviderType
  status    RegistryStatus      @default(ENABLED)
  wallets   TreasuryWallet[]
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("custody_providers")
}

model TreasuryWallet {
  id                   String                       @id @default(uuid()) @db.Uuid
  assetNetworkId       String                       @map("asset_network_id") @db.Uuid
  assetNetwork         AssetNetwork                 @relation(fields: [assetNetworkId], references: [id], onDelete: Restrict)
  custodyProviderId    String                       @map("custody_provider_id") @db.Uuid
  custodyProvider      CustodyProviderConfiguration @relation(fields: [custodyProviderId], references: [id], onDelete: Restrict)
  providerVaultId      String                       @map("provider_vault_id") @db.VarChar(100)
  providerAssetId      String                       @map("provider_asset_id") @db.VarChar(100)
  publicAddress        String                       @map("public_address") @db.VarChar(255)
  addressTag           String?                      @map("address_tag") @db.VarChar(100)
  role                 TreasuryWalletRole           @default(PRIMARY)
  verificationRequired Boolean                      @default(true) @map("verification_required")
  safetyBufferAtomic   BigInt                       @default(0) @map("safety_buffer_atomic")
  gasReserveAtomic     BigInt                       @default(0) @map("gas_reserve_atomic")
  staleAfterSeconds    Int                          @default(60) @map("stale_after_seconds")
  status               RegistryStatus               @default(DISABLED)
  snapshots            TreasurySnapshot[]
  syncJob              TreasurySyncJob?
  fundingIntents       TreasuryFundingIntent[]
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([custodyProviderId, providerVaultId, providerAssetId])
  @@index([assetNetworkId, status])
  @@map("treasury_wallets")
}

model TreasurySnapshot {
  id                      String                     @id @default(uuid()) @db.Uuid
  treasuryWalletId        String                     @map("treasury_wallet_id") @db.Uuid
  treasuryWallet          TreasuryWallet             @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)
  assetNetworkId          String                     @map("asset_network_id") @db.Uuid
  assetNetwork            AssetNetwork               @relation(fields: [assetNetworkId], references: [id], onDelete: Restrict)
  controlledAtomic        BigInt                     @map("controlled_atomic")
  providerAvailableAtomic BigInt                     @map("provider_available_atomic")
  pendingAtomic           BigInt                     @map("pending_atomic")
  frozenAtomic            BigInt                     @map("frozen_atomic")
  lockedAtomic            BigInt                     @map("locked_atomic")
  chainConfirmedAtomic    BigInt?                    @map("chain_confirmed_atomic")
  reservedAtomic          BigInt                     @map("reserved_atomic")
  safetyBufferAtomic      BigInt                     @map("safety_buffer_atomic")
  gasReserveAtomic        BigInt                     @map("gas_reserve_atomic")
  unavailableAtomic       BigInt                     @map("unavailable_atomic")
  sellableAtomic          BigInt                     @map("sellable_atomic")
  verificationStatus      TreasuryVerificationStatus @map("verification_status")
  providerReference       String?                    @map("provider_reference") @db.VarChar(255)
  observedAt              DateTime                   @map("observed_at") @db.Timestamptz(6)
  expiresAt               DateTime                   @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  inventoryState          TreasuryInventoryState?

  @@index([assetNetworkId, observedAt])
  @@map("treasury_snapshots")
}

model TreasuryInventoryState {
  assetNetworkId     String                     @id @map("asset_network_id") @db.Uuid
  assetNetwork       AssetNetwork               @relation(fields: [assetNetworkId], references: [id], onDelete: Restrict)
  latestSnapshotId   String                     @unique @map("latest_snapshot_id") @db.Uuid
  latestSnapshot     TreasurySnapshot           @relation(fields: [latestSnapshotId], references: [id], onDelete: Restrict)
  sellableAtomic     BigInt                     @map("sellable_atomic")
  reservedAtomic     BigInt                     @map("reserved_atomic")
  verificationStatus TreasuryVerificationStatus @map("verification_status")
  evidenceExpiresAt  DateTime                   @map("evidence_expires_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("treasury_inventory_state")
}

model TreasurySyncJob {
  id               String                @id @default(uuid()) @db.Uuid
  treasuryWalletId String                @unique @map("treasury_wallet_id") @db.Uuid
  treasuryWallet   TreasuryWallet        @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)
  status           TreasurySyncJobStatus @default(PENDING)
  nextSyncAt       DateTime              @map("next_sync_at") @db.Timestamptz(6)
  leaseToken       String?               @map("lease_token") @db.Uuid
  leaseExpiresAt   DateTime?             @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount     Int                   @default(0) @map("attempt_count")
  lastErrorCode    String?               @map("last_error_code") @db.VarChar(100)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextSyncAt])
  @@map("treasury_sync_jobs")
}

model TreasuryFundingIntent {
  id               String              @id @default(uuid()) @db.Uuid
  treasuryWalletId String              @map("treasury_wallet_id") @db.Uuid
  treasuryWallet   TreasuryWallet      @relation(fields: [treasuryWalletId], references: [id], onDelete: Restrict)
  assetNetworkId   String              @map("asset_network_id") @db.Uuid
  assetNetwork     AssetNetwork        @relation(fields: [assetNetworkId], references: [id], onDelete: Restrict)
  expectedAtomic   BigInt              @map("expected_atomic")
  status           FundingIntentStatus @default(CREATED)
  transactionHash  String?             @map("transaction_hash") @db.VarChar(255)
  actorId          String              @map("actor_id") @db.VarChar(100)
  reason           String              @db.VarChar(500)
  observedAt       DateTime?           @map("observed_at") @db.Timestamptz(6)
  confirmedAt      DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([assetNetworkId, status])
  @@map("treasury_funding_intents")
}

model ConfigurationVersion {
  id                  Int                  @id @default(autoincrement())
  description         String               @db.VarChar(255)
  actorId             String               @map("actor_id") @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  markets             Market[]
  conversionRoutes    ConversionRoute[]
  manualPriceVersions ManualPriceVersion[]
  quotePolicyVersions QuotePolicyVersion[]
  quotes              Quote[]

  @@map("configuration_versions")
}

model Market {
  id                           String               @id @default(uuid()) @db.Uuid
  baseAssetId                  String               @map("base_asset_id") @db.Uuid
  baseAsset                    Asset                @relation(fields: [baseAssetId], references: [id])
  quoteFiatId                  String               @map("quote_fiat_id") @db.Uuid
  quoteFiat                    FiatCurrency         @relation(fields: [quoteFiatId], references: [id])
  defaultBackingAssetNetworkId String               @map("default_backing_asset_network_id") @db.Uuid
  defaultBackingAssetNetwork   AssetNetwork         @relation(fields: [defaultBackingAssetNetworkId], references: [id])
  spreadBps                    Int                  @default(0) @map("spread_bps")
  fixedFeeAtomic               BigInt               @default(0) @map("fixed_fee_atomic")
  minOrderAtomic               BigInt               @map("min_order_atomic")
  maxOrderAtomic               BigInt               @map("max_order_atomic")
  quoteTtlSeconds              Int                  @map("quote_ttl_seconds")
  status                       RegistryStatus       @default(ENABLED)
  configurationVersionId       Int                  @map("configuration_version_id")
  configurationVersion         ConfigurationVersion @relation(fields: [configurationVersionId], references: [id])
  createdAt                    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  conversionRoutes             ConversionRoute[]
  pricingRefreshJob            PricingRefreshJob?
  quotePolicyVersions          QuotePolicyVersion[]
  quotes                       Quote[]

  @@unique([baseAssetId, quoteFiatId])
  @@map("markets")
}

model PricingRefreshJob {
  id                     String                  @id @default(uuid()) @db.Uuid
  marketId               String                  @unique @map("market_id") @db.Uuid
  market                 Market                  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  refreshIntervalSeconds Int                     @map("refresh_interval_seconds")
  status                 PricingRefreshJobStatus @default(PENDING)
  nextRefreshAt          DateTime                @default(now()) @map("next_refresh_at") @db.Timestamptz(6)
  leaseToken             String?                 @map("lease_token") @db.Uuid
  leaseExpiresAt         DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount           Int                     @default(0) @map("attempt_count")
  lastErrorCode          String?                 @map("last_error_code") @db.VarChar(100)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextRefreshAt])
  @@index([leaseExpiresAt])
  @@map("pricing_refresh_jobs")
}

model PricingProvider {
  id                     String              @id @default(uuid()) @db.Uuid
  code                   String              @unique @db.VarChar(50)
  type                   PricingProviderType
  configurationReference String?             @map("configuration_reference") @db.VarChar(200)
  status                 RegistryStatus      @default(ENABLED)
  pricePairs             ProviderPricePair[]
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("pricing_providers")
}

model PricingInstrument {
  id             String                @id @default(uuid()) @db.Uuid
  kind           PricingInstrumentKind
  assetId        String?               @unique @map("asset_id") @db.Uuid
  asset          Asset?                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  fiatCurrencyId String?               @unique @map("fiat_currency_id") @db.Uuid
  fiatCurrency   FiatCurrency?         @relation(fields: [fiatCurrencyId], references: [id], onDelete: Restrict)
  basePairs      ProviderPricePair[]   @relation("ProviderPairBase")
  quotePairs     ProviderPricePair[]   @relation("ProviderPairQuote")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("pricing_instruments")
}

model ProviderPricePair {
  id                  String               @id @default(uuid()) @db.Uuid
  providerId          String               @map("provider_id") @db.Uuid
  provider            PricingProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  baseInstrumentId    String               @map("base_instrument_id") @db.Uuid
  baseInstrument      PricingInstrument    @relation("ProviderPairBase", fields: [baseInstrumentId], references: [id], onDelete: Restrict)
  quoteInstrumentId   String               @map("quote_instrument_id") @db.Uuid
  quoteInstrument     PricingInstrument    @relation("ProviderPairQuote", fields: [quoteInstrumentId], references: [id], onDelete: Restrict)
  providerPairCode    String               @map("provider_pair_code") @db.VarChar(100)
  priceScale          Int                  @map("price_scale")
  maxAgeSeconds       Int                  @map("max_age_seconds")
  sequenceEnforced    Boolean              @default(false) @map("sequence_enforced")
  status              RegistryStatus       @default(ENABLED)
  observations        PriceObservation[]
  routeLegs           ConversionRouteLeg[]
  guardedRoutes       ConversionRoute[]    @relation("StablecoinGuardPair")
  manualPriceVersions ManualPriceVersion[]
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([providerId, providerPairCode])
  @@unique([providerId, baseInstrumentId, quoteInstrumentId])
  @@map("provider_price_pairs")
}

model PriceObservation {
  id                    String                       @id @default(uuid()) @db.Uuid
  providerPricePairId   String                       @map("provider_price_pair_id") @db.Uuid
  providerPricePair     ProviderPricePair            @relation(fields: [providerPricePairId], references: [id], onDelete: Restrict)
  normalizedRate        Decimal                      @map("normalized_rate") @db.Decimal(60, 30)
  rawRate               String                       @map("raw_rate") @db.VarChar(160)
  providerObservedAt    DateTime                     @map("provider_observed_at") @db.Timestamptz(6)
  providerSequence      String?                      @map("provider_sequence") @db.VarChar(100)
  sequenceGap           Boolean                      @default(false) @map("sequence_gap")
  deduplicationKey      String                       @map("deduplication_key") @db.VarChar(200)
  safeProviderReference String?                      @map("safe_provider_reference") @db.VarChar(200)
  receivedAt            DateTime                     @map("received_at") @db.Timestamptz(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  snapshotInputs        ReferenceRateSnapshotInput[]
  guardedSnapshots      ReferenceRateSnapshot[]      @relation("SnapshotGuardObservation")

  @@unique([providerPricePairId, deduplicationKey])
  @@index([providerPricePairId, providerObservedAt])
  @@map("price_observations")
}

model ConversionRoute {
  id                     String                  @id @default(uuid()) @db.Uuid
  marketId               String                  @map("market_id") @db.Uuid
  market                 Market                  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  version                Int
  outputScale            Int                     @map("output_scale")
  maxAgeSeconds          Int                     @map("max_age_seconds")
  maxDeviationBps        Int                     @map("max_deviation_bps")
  stablecoinGuardPairId  String?                 @map("stablecoin_guard_pair_id") @db.Uuid
  stablecoinGuardPair    ProviderPricePair?      @relation("StablecoinGuardPair", fields: [stablecoinGuardPairId], references: [id], onDelete: Restrict)
  stablecoinExpectedRate Decimal?                @map("stablecoin_expected_rate") @db.Decimal(60, 30)
  stablecoinToleranceBps Int?                    @map("stablecoin_tolerance_bps")
  status                 RegistryStatus          @default(DISABLED)
  configurationVersionId Int                     @map("configuration_version_id")
  configurationVersion   ConfigurationVersion    @relation(fields: [configurationVersionId], references: [id], onDelete: Restrict)
  legs                   ConversionRouteLeg[]
  snapshots              ReferenceRateSnapshot[]
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([marketId, version])
  @@map("conversion_routes")
}

model ConversionRouteLeg {
  id                  String                       @id @default(uuid()) @db.Uuid
  routeId             String                       @map("route_id") @db.Uuid
  route               ConversionRoute              @relation(fields: [routeId], references: [id], onDelete: Restrict)
  sequence            Int
  providerPricePairId String                       @map("provider_price_pair_id") @db.Uuid
  providerPricePair   ProviderPricePair            @relation(fields: [providerPricePairId], references: [id], onDelete: Restrict)
  operation           RouteLegOperation
  snapshotInputs      ReferenceRateSnapshotInput[]
  createdAt           DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([routeId, sequence])
  @@map("conversion_route_legs")
}

model ReferenceRateSnapshot {
  id                 String                       @id @default(uuid()) @db.Uuid
  routeId            String                       @map("route_id") @db.Uuid
  route              ConversionRoute              @relation(fields: [routeId], references: [id], onDelete: Restrict)
  rate               Decimal?                     @db.Decimal(60, 30)
  outputScale        Int                          @map("output_scale")
  roundingMode       RateRoundingMode             @map("rounding_mode")
  status             ReferenceRateStatus
  rejectionReason    String?                      @map("rejection_reason") @db.VarChar(100)
  calculatedAt       DateTime                     @map("calculated_at") @db.Timestamptz(6)
  validUntil         DateTime?                    @map("valid_until") @db.Timestamptz(6)
  inputs             ReferenceRateSnapshotInput[]
  guardObservationId String?                      @map("guard_observation_id") @db.Uuid
  guardObservation   PriceObservation?            @relation("SnapshotGuardObservation", fields: [guardObservationId], references: [id], onDelete: Restrict)
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  quotes             Quote[]

  @@index([routeId, status, calculatedAt])
  @@map("reference_rate_snapshots")
}

model ReferenceRateSnapshotInput {
  snapshotId    String                @map("snapshot_id") @db.Uuid
  snapshot      ReferenceRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  routeLegId    String                @map("route_leg_id") @db.Uuid
  routeLeg      ConversionRouteLeg    @relation(fields: [routeLegId], references: [id], onDelete: Restrict)
  observationId String                @map("observation_id") @db.Uuid
  observation   PriceObservation      @relation(fields: [observationId], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([snapshotId, routeLegId])
  @@map("reference_rate_snapshot_inputs")
}

model ManualPriceVersion {
  id                     String               @id @default(uuid()) @db.Uuid
  providerPricePairId    String               @map("provider_price_pair_id") @db.Uuid
  providerPricePair      ProviderPricePair    @relation(fields: [providerPricePairId], references: [id], onDelete: Restrict)
  version                Int
  rawRate                String               @map("raw_rate") @db.VarChar(160)
  normalizedRate         Decimal              @map("normalized_rate") @db.Decimal(60, 30)
  effectiveFrom          DateTime             @map("effective_from") @db.Timestamptz(6)
  effectiveUntil         DateTime?            @map("effective_until") @db.Timestamptz(6)
  actorId                String               @map("actor_id") @db.VarChar(100)
  reason                 String               @db.VarChar(500)
  configurationVersionId Int                  @map("configuration_version_id")
  configurationVersion   ConfigurationVersion @relation(fields: [configurationVersionId], references: [id], onDelete: Restrict)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([providerPricePairId, version])
  @@index([providerPricePairId, effectiveFrom])
  @@map("manual_price_versions")
}

model QuotePolicyVersion {
  id                     String               @id @default(uuid()) @db.Uuid
  marketId               String               @map("market_id") @db.Uuid
  market                 Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  version                Int
  spreadBps              Int                  @map("spread_bps")
  fixedFeeAtomic         BigInt               @map("fixed_fee_atomic")
  percentageFeeBps       Int                  @map("percentage_fee_bps")
  minTotalDebitAtomic    BigInt               @map("min_total_debit_atomic")
  maxTotalDebitAtomic    BigInt               @map("max_total_debit_atomic")
  quoteTtlSeconds        Int                  @map("quote_ttl_seconds")
  rateDisplayScale       Int                  @map("rate_display_scale")
  status                 QuotePolicyStatus
  configurationVersionId Int                  @map("configuration_version_id")
  configurationVersion   ConfigurationVersion @relation(fields: [configurationVersionId], references: [id], onDelete: Restrict)
  actorId                String               @map("actor_id") @db.VarChar(100)
  reason                 String               @db.VarChar(500)
  effectiveFrom          DateTime             @map("effective_from") @db.Timestamptz(6)
  effectiveUntil         DateTime?            @map("effective_until") @db.Timestamptz(6)
  quotes                 Quote[]
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([marketId, version])
  @@index([marketId, status, effectiveFrom])
  @@map("quote_policy_versions")
}

model Quote {
  id                      String                  @id @default(uuid()) @db.Uuid
  side                    QuoteSide
  marketId                String                  @map("market_id") @db.Uuid
  market                  Market                  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  backingAssetNetworkId   String                  @map("backing_asset_network_id") @db.Uuid
  backingAssetNetwork     AssetNetwork            @relation(fields: [backingAssetNetworkId], references: [id], onDelete: Restrict)
  referenceRateSnapshotId String                  @map("reference_rate_snapshot_id") @db.Uuid
  referenceRateSnapshot   ReferenceRateSnapshot   @relation(fields: [referenceRateSnapshotId], references: [id], onDelete: Restrict)
  quotePolicyVersionId    String                  @map("quote_policy_version_id") @db.Uuid
  quotePolicyVersion      QuotePolicyVersion      @relation(fields: [quotePolicyVersionId], references: [id], onDelete: Restrict)
  configurationVersionId  Int                     @map("configuration_version_id")
  configurationVersion    ConfigurationVersion    @relation(fields: [configurationVersionId], references: [id], onDelete: Restrict)
  totalDebitAtomic        BigInt                  @map("total_debit_atomic")
  fixedFeeAtomic          BigInt                  @map("fixed_fee_atomic")
  percentageFeeAtomic     BigInt                  @map("percentage_fee_atomic")
  percentageFeeBps        Int                     @map("percentage_fee_bps")
  totalFeeAtomic          BigInt                  @map("total_fee_atomic")
  tradeAmountAtomic       BigInt                  @map("trade_amount_atomic")
  spreadBps               Int                     @map("spread_bps")
  spreadAmountAtomic      BigInt                  @map("spread_amount_atomic")
  destinationAmountAtomic BigInt                  @map("destination_amount_atomic")
  quoteFiatDecimals       Int                     @map("quote_fiat_decimals")
  baseAssetDecimals       Int                     @map("base_asset_decimals")
  referenceRate           Decimal                 @map("reference_rate") @db.Decimal(60, 30)
  customerRate            Decimal                 @map("customer_rate") @db.Decimal(60, 30)
  rateDisplayScale        Int                     @map("rate_display_scale")
  feeRoundingMode         FeeRoundingMode         @map("fee_rounding_mode")
  destinationRoundingMode DestinationRoundingMode @map("destination_rounding_mode")
  expiresAt               DateTime                @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([marketId, createdAt])
  @@index([expiresAt])
  @@map("quotes")
}

model ConfigurationAuditLog {
  id                   String   @id @default(uuid()) @db.Uuid
  configurationVersion Int      @map("configuration_version")
  actorId              String   @map("actor_id") @db.VarChar(100)
  action               String   @db.VarChar(50)
  resourceType         String   @map("resource_type") @db.VarChar(50)
  resourceId           String   @map("resource_id") @db.VarChar(100)
  before               Json?
  after                Json?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId, createdAt])
  @@map("configuration_audit_logs")
}

model ServiceCredential {
  id         String                @id @default(uuid()) @db.Uuid
  clientId   String                @map("client_id") @db.VarChar(100)
  keyId      String                @unique @map("key_id") @db.VarChar(100)
  status     CredentialStatus      @default(ACTIVE)
  validFrom  DateTime              @map("valid_from") @db.Timestamptz(6)
  validUntil DateTime?             @map("valid_until") @db.Timestamptz(6)
  revokedAt  DateTime?             @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  nonces     AuthenticationNonce[]

  @@index([clientId, status])
  @@map("service_credentials")
}

model AuthenticationNonce {
  id           String            @id @default(uuid()) @db.Uuid
  credentialId String            @map("credential_id") @db.Uuid
  credential   ServiceCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  nonceHash    String            @map("nonce_hash") @db.Char(64)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([credentialId, nonceHash])
  @@index([expiresAt])
  @@map("authentication_nonces")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  clientId       String            @map("client_id") @db.VarChar(100)
  operation      String            @db.VarChar(100)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(200)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseCode   Int?              @map("response_code")
  responseBody   Json?             @map("response_body")
  correlationId  String            @map("correlation_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([clientId, operation, idempotencyKey])
  @@index([status, createdAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  aggregateType  String       @map("aggregate_type") @db.VarChar(100)
  aggregateId    String       @map("aggregate_id") @db.VarChar(100)
  eventType      String       @map("event_type") @db.VarChar(150)
  payload        Json
  correlationId  String       @map("correlation_id") @db.Uuid
  status         OutboxStatus @default(PENDING)
  attemptCount   Int          @default(0) @map("attempt_count")
  maxAttempts    Int          @default(10) @map("max_attempts")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseToken     String?      @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz(6)
  quarantinedAt  DateTime?    @map("quarantined_at") @db.Timestamptz(6)
  lastErrorCode  String?      @map("last_error_code") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
  @@map("outbox_events")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorType     String   @map("actor_type") @db.VarChar(50)
  actorId       String   @map("actor_id") @db.VarChar(100)
  correlationId String   @map("correlation_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([correlationId])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}
